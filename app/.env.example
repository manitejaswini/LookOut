# Copy to app/.env.local (gitignored) and fill in. Never commit real values.
# World ID is configured here, NOT in the repo-root .env, so the web server never receives the Arkiv wallet's private key.
#
# From the World Developer Portal: https://developer.world.org  (create an app, enable World ID 4.0 / RP registration)
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
# SECRET: the RP signing key. Server only. If it leaks, anyone can forge proof requests from your app.
RP_SIGNING_KEY=
# production (default) | staging | sandbox. Use staging ONLY while testing with the World ID simulator.
WORLD_ID_ENVIRONMENT=production

# OPTIONAL. Off by default, because a key tells Arkiv which visitors check what. Arkiv gives keyless queries only a small shared
# budget (ANON_COST_LIMITED), and when it runs out the wallet page withholds its answer instead of guessing. For a demo that must
# not stall, create a SEPARATE Arkiv key (Hub > Access Keys), lock it to your site, and put it here. It is public in the browser.
NEXT_PUBLIC_ARKIV_READ_KEY=

# The deployed LookoutEscrow (npm run escrow:deploy at the repo root prints it). Public. Without it the report form says deposits are not available.
NEXT_PUBLIC_ESCROW_ADDRESS=

# The operator service API (npm run operator:run). Read only.
NEXT_PUBLIC_PANEL_URL=

# OPTIONAL. Your own Sepolia RPC URL (an Alchemy or Infura key). The app reads Sepolia through it first, then through public endpoints that can rate limit.
NEXT_PUBLIC_SEPOLIA_RPC=

# OPTIONAL. The World ID action name, if it must match one you registered in the Developer Portal (default lookout-verified-human-v1).
# World ID rejects an action that is not registered for your app. Set the same value in the repo-root .env, which the operator reads.
WORLD_ID_ACTION=
