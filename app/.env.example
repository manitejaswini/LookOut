# Copy to app/.env.local (gitignored) and fill in. Never commit real values.
# World ID is configured here, NOT in the repo-root .env, so the web server never receives the Arkiv wallet's private key.
#
# From the World Developer Portal: https://developer.world.org  (create an app, enable World ID 4.0 / RP registration)
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
# SECRET: the RP signing key. Server only. If it leaks, anyone can forge proof requests from your app.
RP_SIGNING_KEY=
# production (default) | staging | sandbox. Use staging ONLY while testing with the World ID simulator.
WORLD_ID_ENVIRONMENT=production
