{
  "name": "lookout",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "attack": "node scripts/attack-sim.ts",
    "wallet:new": "node scripts/new-wallet.mjs",
    "arkiv:check": "node scripts/check-arkiv.mjs",
    "arkiv:smoke": "node scripts/arkiv-smoke.mjs",
    "arkiv:demo": "node scripts/arkiv-demo.mjs",
    "indexer:sync": "npm run sync -w @lookout/indexer",
    "indexer:serve": "npm run serve -w @lookout/indexer",
    "check": "npm run check -w @lookout/workers --",
    "verify": "npm run typecheck && npm test && npm run attack"
  }
}
